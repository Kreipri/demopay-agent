{
  "name": "demopay",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/agent/src/*.test.ts apps/server/src/*.test.ts",
    "setup:testnet": "node --env-file-if-exists=.env --import tsx scripts/setup-testnet.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
